CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# app_main initializes the BSP/LVGL UI through deep startup call chains.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_SPEED_40M is not set
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep mbedTLS's sub-16 KiB allocations internal; larger calloc requests prefer PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=1
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=160
